{
  "manifest_version": 3,
  "name": "DK Live Block",
  "version": "0.1.0",
  "description": "Built-in DK Browser preliminary network and cosmetic filtering, based on DK Live Block local fallback rules.",
  "key": "",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "dk_live_block_seed",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "cosmetics.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "css": [
        "youtube.css"
      ],
      "run_at": "document_start"
    }
  ]
}
