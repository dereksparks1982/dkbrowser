# Bundled DK Live Block v0.3.371 (complete source snapshot, Chromium MV3).
# Source assets are copied into Chromium DIR_RESOURCES as normal product
# files. This component is not a Firefox/Chrome Web Store extension.
# Do not add Actions, runtime network downloads or external installers.
group("component_resources") {
  deps = [
    ":root_assets",
    ":runtime_root_assets",
    ":runtime_redirect_assets",
    ":runtime_vendor_assets",
    ":runtime_icons",
  ]
}

copy("root_assets") {
  sources = [
    "manifest.json",
    "rules.json",
    "cosmetics.css",
    "youtube.css",
    "DK_LIVE_BLOCK_LICENSE.txt",
    "chromium-background.js",
    "chromium-compat.js",
    "chromium-dnr.js",
  ]
  outputs = [ "$root_out_dir/resources/dk_live_block/{{source_file_part}}" ]
}

