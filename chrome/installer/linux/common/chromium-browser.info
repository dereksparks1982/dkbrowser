# This file provides common configuration information for building
# DK NetNav packages for supported Linux platforms.

# Base name of the package.
PACKAGE="dk-netnav"

# Base name of the snap package
SNAPNAME="dk-netnav"

# Filename of the main executable (for generating launcher scripts, etc.)
PROGNAME=chrome

# Base directory for package installation.
INSTALLDIR=/opt/dksoftworks/dk-netnav

# Directory for device policy enrollments.
ENROLLMENTDIR=/etc/dk-netnav/policies/enrollment

# Display string for desktop menu/icon.
MENUNAME="DK NetNav"

# Brief package description.
SHORTDESC="DK NetNav, a free browser based on Chromium"

# Detailed package description.
FULLDESC="DK NetNav is a free and open-source Chromium-based browser with English and Russian editions, media playback features, and user-controlled settings."

# Package maintainer information.
MAINTNAME="DK Softworks"
MAINTMAIL="dereksparks1982@users.noreply.github.com"
PRODUCTURL="https://github.com/dereksparks1982/dknetnav"

PROJECT_LICENSE="BSD-3-Clause and LGPL-2.1+ and Apache-2.0 and IJG and MIT and GPL-2.0+ and ISC and OpenSSL and (MPL-1.1 or GPL-2.0 or LGPL-2.0)"

DEVELOPER_NAME="DK Softworks and The Chromium Authors"

BUGTRACKERURL="https://github.com/dereksparks1982/dknetnav/issues"

HELPURL="https://chromium.googlesource.com/chromium/src/+/main/docs/linux/debugging.md"

RDN="io.github.dereksparks1982.DKBrowser"
